{
  "name": "internship-rest-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Milestone 3 REST API and Persistent Data using Node.js, Express.js, and SQLite.",
  "scripts": {
    "start": "tsx server.ts",
    "dev": "tsx server.ts",
    "test": "vitest run",
    "seed": "tsx src/db/seed.ts",
    "build": "tsc --noEmit",
    "clean": "rm -rf dist data/*.db",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "supertest": "^7.0.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^6.0.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^3.0.7"
  }
}
